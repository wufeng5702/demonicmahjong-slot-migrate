{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,scss,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,css,scss,md,json}\""
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.22.0"
  },
  "packageManager": "pnpm@11.22.0",
  "prepare": "husky install",
  "lint-staged": {
    "src/**/*.{js,ts,vue,css,scss,md,json}": [
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "@wailsio/runtime": "^3.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.2.37"
  },
  "devDependencies": {
    "@babel/types": "^8.0.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.10"
  }
}
